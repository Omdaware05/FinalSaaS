# ============================================================
# FinalSaaS Frontend Environment Configuration
# Copy this file to .env before starting the Vite frontend
# ============================================================

# Backend API base URL.
# Leave it relative (/api/v1) for same-origin deployments — the Vite
# dev server and the production nginx both proxy /api to the backend,
# so no host needs to be baked into the bundle.
# Set an absolute URL only for split deployments where the frontend
# and backend are served from different origins.
VITE_API_BASE_URL=/api/v1
