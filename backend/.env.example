# ============================================================
# FinalSaaS backend configuration — copy to ".env" and fill in:
#   cp backend/.env.example backend/.env
# Never commit the real .env file. Every value below is a
# placeholder — this file contains NO real secrets.
# ============================================================

# ---- Security / auth (REQUIRED) ----
# Signs JWT login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (setup.sh / setup.bat generate this automatically.)
SECRET_KEY=change-me-generate-a-random-one

# First admin account, created by `python -m app.seed` when the DB is empty.
ADMIN_EMAIL=admin@finalsaas.local
# Leave empty for laptop setup: setup.sh / setup.bat generate a random
# password, write it here and print it once. For Docker, set it yourself.
ADMIN_PASSWORD=

# ---- Database ----
# Default: SQLite file inside the data directory (zero setup).
DATABASE_URL=sqlite+aiosqlite:///./data/finalsaas.db
# Production (PostgreSQL, see docker-compose "postgres" profile):
# DATABASE_URL=postgresql+asyncpg://finalsaas:<password>@postgres:5432/finalsaas

# ---- Public URL (REQUIRED for real phone calls) ----
# Public HTTPS address the carrier (VoBiz) can reach for answer/stream/
# hangup webhooks. Examples: https://calls.yourcompany.com
# or a tunnel for laptop demos: https://xxxx.ngrok-free.app
# Calls fail with PUBLIC_URL_NOT_CONFIGURED while this is empty/localhost.
PUBLIC_BASE_URL=

# Shared secret the carrier webhooks are signed/verified with.
# Generate like SECRET_KEY. Webhooks are rejected if this is set on the
# carrier side but wrong/missing here.
WEBHOOK_SECRET=

# ---- Telephony carrier: VoBiz (REQUIRED for real phone calls) ----
# From your VoBiz account. Without these, calls fail fast with
# TELEPHONY_NOT_CONFIGURED instead of dialling.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# The caller ID / DID number calls are placed from (E.164, e.g. +91...)
VOBIZ_FROM_NUMBER=

# ---- Voice AI provider ----
# "sarvam" = Sarvam cloud (default, works anywhere).
# "local"  = your own OpenAI-compatible server (see docs/LOCAL_MODELS.md).
VOICE_PROVIDER=sarvam

# Sarvam cloud (used when VOICE_PROVIDER=sarvam)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_DEFAULT_VOICE=shubh

# Local models (used when VOICE_PROVIDER=local)
# Point LOCAL_AI_BASE_URL at any OpenAI-compatible server on port 8002
# (LM Studio, Ollama, or the legacy local AI server) exposing:
#   POST /audio/transcriptions   (STT)
#   POST /chat/completions       (LLM)
#   POST /audio/speech           (TTS)
LOCAL_AI_BASE_URL=http://localhost:8002/v1
LOCAL_AI_API_KEY=
LOCAL_STT_MODEL=whisper-large-v3-turbo
LOCAL_LLM_MODEL=
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart

# ---- Calling rules / safety ----
# Outbound calls are only placed inside this window (business timezone).
CALLING_HOURS_START=9
CALLING_HOURS_END=21
BUSINESS_TIMEZONE=Asia/Kolkata
# Hard cap enforced per agent, regardless of campaign settings.
MAX_CONCURRENT_CALLS_PER_AGENT=5

# ---- Storage for recordings ----
# "local" = data/ directory on this machine. "s3" = S3/MinIO bucket.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=finalsaas-recordings
S3_REGION=us-east-1

# ---- CORS ----
# JSON list of allowed dashboard origins. Keep this tight in production.
CORS_ORIGINS=["http://localhost:5173"]

# ---- Demo data ----
# true = seed the 3 demo agents on first run (see README).
SEED_DEMO=true
